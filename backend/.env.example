# Yadadri Stay Backend Environment Configuration
# Copy this file to .env and fill in your values

# Server Configuration
NODE_ENV=development
PORT=5000
API_BASE_URL=http://localhost:5000/api

# MongoDB Configuration
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/yadadri-stay?retryWrites=true&w=majority
MONGODB_URI_TEST=mongodb+srv://username:password@cluster.mongodb.net/yadadri-stay-test?retryWrites=true&w=majority

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-min-32-chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your-refresh-secret-key-min-32-chars
JWT_REFRESH_EXPIRES_IN=30d

# Frontend URLs (for CORS)
ADMIN_DASHBOARD_URL=http://localhost:5173
OWNER_DASHBOARD_URL=http://localhost:5174
ANDROID_APP_PACKAGE=com.yadadristay.app

# Cloudinary Configuration (Image/Video Storage)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Email Configuration (Optional - for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=noreply@yadadristay.com

# UPI Configuration
UPI_VPA=yourbusiness@upi
UPI_QR_CODE_URL=https://your-cdn.com/upi-qr-code.png
ADVANCE_PAYMENT_PERCENTAGE=20

# Default Check-in/Check-out Times (24-hour format)
DEFAULT_CHECKIN_TIME=12:00
DEFAULT_CHECKOUT_TIME=11:00

# Payment Verification Timeout (hours)
PAYMENT_VERIFICATION_TIMEOUT_HOURS=24

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# File Upload Limits
MAX_FILE_SIZE_MB=10
MAX_IMAGES_PER_LODGE=20
MAX_VIDEOS_PER_LODGE=5

# Super Admin Setup (Used only during first-time setup)
SUPER_ADMIN_EMAIL=admin@yadadristay.com
SUPER_ADMIN_PASSWORD=SecureAdminPass123!
SUPER_ADMIN_PHONE=9876543210

# Logging
LOG_LEVEL=info